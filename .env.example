# Backend
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# --- Gemini (primary LLM + embeddings) ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# GEMINI_TUTOR_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=embedding-001

# OpenAI (optional legacy — unused when Gemini is configured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_TUTOR_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Docker: set to repo root inside container (see docker-compose / Dockerfile)
# ATOMADAPT_ROOT=/repo

# --- Auth ---
# CHANGE THIS in any real deployment (used to sign session tokens)
AUTH_SECRET_KEY=change-me-in-prod-please-32-bytes-min-aurex-atomadapt
AUTH_TOKEN_TTL_MINUTES=10080
PASSWORD_RESET_TTL_MINUTES=30

# Google OAuth 2.0 — Web client ID from Google Cloud > APIs & Services > Credentials
GOOGLE_CLIENT_ID=

# --- SMTP (Gmail App Password works here) ---
# Generate at https://myaccount.google.com/apppasswords (requires 2-Step Verification on the sending account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=AtomAdapt
SMTP_USE_TLS=true

# Frontend (browser → API)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_GOOGLE_CLIENT_ID must match GOOGLE_CLIENT_ID above
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
